    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Valida e achata o cadastro da familia. Nunca repassa campos extras.\nconst out = [];\nfor (const item of $input.all()) {\n  const b = (item.json && item.json.body) || item.json || {};\n  const erro = (msg) => out.push({ json: { ok: false, erro: msg } });\n  const o = (v) => (v && typeof v === 'object' && !Array.isArray(v) ? v : {});\n  const s = (v) => (typeof v === 'string' ? v.trim() : (typeof v === 'number' ? String(v) : ''));\n\n  if (typeof b !== 'object' || Array.isArray(b)) { erro('corpo invalido'); continue; }\n\n  // Rejeita qualquer string grande em qualquer lugar (ex.: foto em dataURL)\n  let grande = false;\n  const varre = (v, n) => {\n    if (grande || n > 6) return;\n    if (typeof v === 'string') { if (v.length > 500) grande = true; }\n    else if (Array.isArray(v)) v.forEach((x) => varre(x, n + 1));\n    else if (v && typeof v === 'object') Object.values(v).forEach((x) => varre(x, n + 1));\n  };\n  varre(b, 0);\n  if (grande) { erro('campo grande demais'); continue; }\n\n  const r = o(b.responsavel), c = o(b.crianca), k = o(b.consentimento);\n  const nomeResp = s(r.nome), nomeCri = s(c.nome);\n  const email = s(r.email).toLowerCase();\n  let zap = s(r.whatsapp).replace(/\\D/g, '');\n  if (zap && !zap.startsWith('55')) zap = '55' + zap;\n  if (zap && (zap.length < 12 || zap.length > 13)) zap = '';\n\n  if (!nomeResp) { erro('falta nome do responsavel'); continue; }\n  if (!nomeCri) { erro('falta nome da crianca'); continue; }\n  if (!email && !zap) { erro('falta email ou whatsapp'); continue; }\n\n  const semAcento = (t) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\\s+/g, ' ').trim();\n  const chave = (zap || email) + '|' + semAcento(nomeCri);\n\n  const nasc = /^\\d{4}-\\d{2}-\\d{2}$/.test(s(c.nascimento)) ? s(c.nascimento) : '';\n  let idade = '';\n  if (nasc) {\n    const [y, m, d] = nasc.split('-').map(Number);\n    const h = new Date();\n    let i = h.getUTCFullYear() - y;\n    if (h.getUTCMonth() + 1 < m || (h.getUTCMonth() + 1 === m && h.getUTCDate() < d)) i--;\n    if (i >= 0 && i < 120) idade = i;\n  }\n\n  out.push({ json: {\n    ok: true,\n    chave,\n    atualizado_em: new Date().toISOString(),\n    responsavel: nomeResp,\n    email,\n    whatsapp: zap,\n    cidade: s(r.cidade),\n    uf: s(r.uf).toUpperCase().slice(0, 2),\n    crianca: nomeCri,\n    nascimento: nasc,\n    idade,\n    genero: s(c.genero),\n    tem_foto: c.temFoto === true ? 'sim' : 'nao',\n    aceita_novidades: k.novidades === true ? 'sim' : 'nao',\n    consentimento_em: s(k.em),\n    versao_app: s(b.versao),\n    aparelho: s(b.userAgent).slice(0, 200),\n  } });\n}\nreturn out;\n"
      },
